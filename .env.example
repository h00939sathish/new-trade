# --- Event Store ---
TRA_EVENT_STORE_TYPE=sqlite

# --- Postgres (used when TRA_EVENT_STORE_TYPE=postgres) ---
TRA_POSTGRES_DSN=postgresql+asyncpg://trading:trading@localhost:5432/trading

# --- Kafka ---
TRA_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TRA_KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
TRA_KAFKA_GROUP_ID=trading-system

# --- Redis ---
TRA_REDIS_URL=redis://localhost:6379/0

# --- Kite/Zerodha (for order execution) ---
TRA_KITE_API_KEY=your_api_key
TRA_KITE_API_SECRET=your_api_secret
TRA_KITE_ACCESS_TOKEN=your_access_token
TRA_KITE_USER_ID=your_user_id

# --- Groww (for market data) ---
TRA_GROWW_API_KEY=your_groww_jwt
TRA_GROWW_API_SECRET=your_groww_api_secret
TRA_GROWW_TOTP_SECRET=your_groww_totp_secret
TRA_GROWW_AUTH_TOKEN=your_groww_auth_token

# --- Agent Config ---
TRA_AGENT_MARKET_INTEL_ENABLED=true
TRA_AGENT_STRATEGY_GEN_ENABLED=false
TRA_AGENT_RISK_MGMT_ENABLED=true
TRA_AGENT_EXECUTION_ENABLED=false

# --- Risk Limits ---
TRA_RISK_MAX_POSITION_SIZE=100000
TRA_RISK_MAX_DRAWDOWN_PCT=0.15
TRA_RISK_MAX_LEVERAGE=3.0
TRA_RISK_MAX_ORDER_VALUE=50000

# --- Notifications ---
# Telegram (optional — set both to enable)
# TRA_TELEGRAM_BOT_TOKEN=
# TRA_TELEGRAM_CHAT_ID=

# ntfy.sh push notifications (optional — set TRA_NTFY_TOPIC to enable)
# TRA_NTFY_TOPIC=your-topic
# TRA_NTFY_SERVER=https://ntfy.sh

# --- Logging ---
TRA_LOG_LEVEL=INFO
