# Example file for docker-compose environment variables.
# Copy to .env (in repo root) and fill in real values.
# Generate TRA_HTTP_AUTH_TOKEN with: openssl rand -hex 32

# --- Required (compose will fail without these) ---
TRA_HTTP_AUTH_TOKEN=

# --- Postgres ---
TRA_POSTGRES_DSN=postgresql+asyncpg://trading:trading@postgres:5432/trading

# --- Redis ---
TRA_REDIS_URL=redis://redis:6379/0

# --- Kite/Zerodha ---
TRA_KITE_API_KEY=
TRA_KITE_API_SECRET=
TRA_KITE_ACCESS_TOKEN=
TRA_KITE_USER_ID=

# --- Groww ---
TRA_GROWW_API_KEY=
TRA_GROWW_API_SECRET=
TRA_GROWW_TOTP_SECRET=
TRA_GROWW_AUTH_TOKEN=

# --- Watchlist ---
TRA_WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK
